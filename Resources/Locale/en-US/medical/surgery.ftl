# Generic
surgery-step-not-valid = You cannot perform {$action} here.
surgery-no-woundable-limb = There is no treatable limb there.
surgery-cannot-reach = You cannot reach there with {$tool}.
surgery-patient-not-ready = The patient must be unconscious or anesthetized for surgery.
surgery-patient-conscious = The patient is conscious! Surgery will be more difficult.
surgery-tool-slipped = Your tool slips! The procedure fails.
surgery-in-progress = Surgery is already in progress on this area.
surgery-clothing-blocking = The material covering this area is too thick for surgery.
surgery-step-fail = Your hand slips!
surgery-no-organs = There are no internal organs in this body.
surgery-no-organs-in-limb = There are no internal organs in this area.
surgery-not-an-organ = That is not an organ.
surgery-organ-still-attached = The organ is still attached to another body.

# Incision
surgery-incision-start = You start making an incision on {THE($target)} with {$tool}.
surgery-incision-end = You make an incision.
surgery-incision-fail = Your hand slips, slicing {THE($limb)} in the wrong place!

surgery-incision-laser-start = You start the bloodless incision on {THE($target)} with {$tool}.
surgery-incision-laser-end = You make a bloodless incision.
surgery-incision-laser-fail = Your hand slips as the laser sputters, searing a gash in {THE($limb)}!

surgery-incision-managed-start = You start to construct a prepared incision on {THE($target)} with {$tool}.
surgery-incision-managed-end = You construct a managed incision with clamping and retraction.
surgery-incision-managed-fail = Your hand jolts as the system sparks, ripping a hole in {THE($limb)}!

# Clamp
surgery-clamp-start = You start clamping bleeders in {THE($target)} with {$tool}.
surgery-clamp-end = You clamp the bleeders.
surgery-clamp-fail = Your hand slips, tearing blood vessels in {THE($limb)}!

# Retract
surgery-retract-start = You start to pry open the incision on {THE($target)} with {$tool}.
surgery-retract-end = You retract the skin.
surgery-retract-fail = Your hand slips, tearing the edges of the incision on {THE($limb)}!

# Cauterize
surgery-cauterize-start = You begin to cauterize the incision on {THE($target)} with {$tool}.
surgery-cauterize-end = You cauterize the incision.
surgery-cauterize-fail = Your hand slips, burning {THE($limb)}!

# Saw bone (encased)
surgery-saw-start = You begin to cut through {THE($target)} with {$tool}.
surgery-saw-end = You cut through the {$bone} open.
surgery-saw-fail = Your hand slips, cracking the bone in {THE($limb)}!

# Bone repair
surgery-boneglue-start = You start applying bone adhesive on {THE($target)} with {$tool}.
surgery-boneglue-end = You apply bone adhesive to the fracture.
surgery-boneglue-fail = Your hand slips, smearing adhesive in the incision!

surgery-boneset-start = You start to set the bone in {THE($target)} with {$tool}.
surgery-boneset-end = You set the bone in place.
surgery-boneset-fail = Your hand slips, damaging the bone!

surgery-bonefinish-start = You start to apply the final coat of bone adhesive on {THE($target)} with {$tool}.
surgery-bonefinish-end = You finish the bone repair.
surgery-bonefinish-fail = Your hand slips, smearing the final coat of adhesive in the incision!
surgery-bone-not-broken = The bone is not broken.

# Amputation
surgery-amputate-start = You begin to amputate {THE($target)} with {$tool}.
surgery-amputate-end = You amputate the limb.
surgery-amputate-fail = Your hand slips, sawing through the bone incorrectly!

# Organ surgery
surgery-organ-detach-start = You start to detach the organ in {THE($target)} with {$tool}.
surgery-organ-detached = You carefully detach the {$organ} from its connections.

surgery-organ-remove-start = You start to remove the organ from {THE($target)} with {$tool}.
surgery-organ-removed = You remove the {$organ} from the body cavity.

surgery-organ-replace-start = You start to insert the organ into {THE($target)} with {$tool}.
surgery-organ-replaced = You place the {$organ} into the body cavity.

surgery-organ-attach-start = You start to attach the organ in {THE($target)} with {$tool}.
surgery-organ-attached = You connect the blood vessels and secure the organ in place.

surgery-organ-fix-start = You begin repairing the internal organ in {THE($target)} with {$tool}.
surgery-organ-repaired = You repair the damaged organ.

surgery-organ-detach-fail = Your hand slips, tearing the connections holding the organ in {THE($limb)}!
surgery-organ-remove-fail = Your hand slips, damaging tissue as you try to remove the organ from {THE($limb)}!
surgery-organ-replace-fail = Your hand slips, dropping the organ into {THE($limb)}! It may be damaged!
surgery-organ-attach-fail = Your hand slips, damaging the blood vessels while trying to attach the organ in {THE($limb)}!
surgery-organ-fix-fail = Your hand slips, worsening the damage to the internal organ in {THE($limb)}!
surgery-organ-fail = Your hand slips inside {THE($limb)}, damaging internal tissue!

# Embedded objects
surgery-embedded-start = You begin removing an embedded object from {THE($target)} with {$tool}.
surgery-embedded-removed = You remove the embedded object from the wound.
surgery-embedded-fail = Your hand slips, pushing the object deeper into {THE($limb)}!
surgery-no-embedded = There are no embedded objects in this wound.

# Limb reattachment
surgery-clean-stump-start = You start cleaning the stump on {THE($target)} with {$tool}.
surgery-clean-stump-end = You clean and debride the stump, preparing it for reattachment.
surgery-clean-stump-fail = Your hand slips, damaging the stump on {THE($limb)}!

surgery-tendon-repair-start = You begin reconnecting the tendons on {THE($target)} with {$tool}.
surgery-tendon-repair-end = You carefully reconnect the severed tendons.
surgery-tendon-repair-fail = Your hand slips, tearing the delicate tendon tissue!

surgery-muscle-repair-start = You start suturing the muscle tissue on {THE($target)} with {$tool}.
surgery-muscle-repair-end = You suture the muscle tissue, rejoining the limb.
surgery-muscle-repair-fail = Your hand slips, damaging the muscle fibers!

surgery-close-reattachment-start = You begin closing the reattachment site on {THE($target)} with {$tool}.
surgery-close-reattachment-end = The limb is successfully reattached!
surgery-close-reattachment-fail = Your hand slips, damaging the reattachment site!
surgery-reattach-no-limb = There is no severed limb nearby that matches this stump.

# Facial surgery
surgery-mend-facial-start = You begin repairing the facial wounds on {THE($target)} with {$tool}.
surgery-mend-facial-end = You carefully mend the facial wounds and disfigurement.
surgery-mend-facial-fail = Your hand slips, aggravating the facial wounds!

surgery-repair-eye-start = You begin repairing the damaged eye of {THE($target)} with {$tool}.
surgery-repair-eye-end = You carefully repair the damaged eye.
surgery-repair-eye-fail = Your hand slips, damaging the eye further!

surgery-repair-ear-start = You begin repairing the damaged ear of {THE($target)} with {$tool}.
surgery-repair-ear-end = You carefully repair the damaged ear.
surgery-repair-ear-fail = Your hand slips, damaging the ear further!

# Implant surgery
surgery-implant-item-start = You begin implanting an item into {THE($target)} with {$tool}.
surgery-implant-item-end = You successfully implant the item into the body cavity.
surgery-implant-item-fail = Your hand slips, damaging the item as you implant it!
surgery-implant-no-item = You need to hold an item you want to implant in your other hand.
surgery-implant-no-space = There is no space in the body cavity for another implant.

surgery-remove-implant-start = You begin removing an implanted item from {THE($target)} with {$tool}.
surgery-remove-implant-end = You successfully remove the implanted item.
surgery-remove-implant-fail = Your hand slips, damaging the body cavity!
surgery-remove-implant-none = There are no implanted items to remove.

# Robotic limb surgery
surgery-open-hatch-start = You begin unscrewing the access panel on {THE($target)} with {$tool}.
surgery-open-hatch-end = You open the robotic limb's access panel.
surgery-open-hatch-fail = Your screwdriver slips, scratching the robotic limb!

surgery-close-hatch-start = You begin sealing the access panel on {THE($target)} with {$tool}.
surgery-close-hatch-end = You close and secure the robotic limb's access panel.
surgery-close-hatch-fail = Your tool slips, denting the access panel!

surgery-weld-brute-start = You begin welding the structural damage on {THE($target)} with {$tool}.
surgery-weld-brute-end = You weld the structural damage on the robotic limb.
surgery-weld-brute-fail = Your welding torch slips, scorching the robotic limb!

surgery-replace-wires-start = You begin replacing the fried wiring in {THE($target)} with {$tool}.
surgery-replace-wires-end = You replace the damaged wiring in the robotic limb.
surgery-replace-wires-fail = Your hand slips, damaging the wiring harness!

surgery-detach-robotic-start = You begin unbolting the robotic limb from {THE($target)} with {$tool}.
surgery-detach-robotic-end = You detach the robotic limb from its mount.
surgery-detach-robotic-fail = Your tool slips, damaging the mounting port!

# Other procedures
surgery-autopsy-start = You begin performing an autopsy on {THE($target)} with {$tool}.
surgery-autopsy-end = You complete the autopsy and document your findings.
surgery-autopsy-fail = Your hand slips, damaging the tissue!

# Amputation effects
amputation-no-legs = You have no legs! You collapse to the ground!
amputation-one-leg = You only have one leg left! You stumble.
amputation-no-grasp = You can no longer grasp with your {$limb}!
