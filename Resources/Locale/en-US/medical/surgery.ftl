# Generic
surgery-step-not-valid = You cannot perform {$action} here.
surgery-no-woundable-limb = There is no treatable limb there.
surgery-cannot-reach = You cannot reach there with {$tool}.
surgery-patient-not-ready = The patient must be unconscious or anesthetized for surgery.
surgery-patient-conscious = The patient is conscious! Surgery will be more difficult.
surgery-tool-slipped = Your tool slips! The procedure fails.
surgery-in-progress = Surgery is already in progress on this area.
surgery-clothing-blocking = The material covering this area is too thick for surgery.
surgery-step-fail = Your hand slips!
surgery-no-organs = There are no internal organs in this body.
surgery-no-organs-in-limb = There are no internal organs in this area.
surgery-not-an-organ = That is not an organ.
surgery-organ-still-attached = The organ is still attached to another body.

# Incision
surgery-incision-start = You start making an incision on {THE($target)} with {$tool}.
surgery-incision-end = You make an incision.
surgery-incision-fail = Your hand slips, slicing {THE($limb)} in the wrong place!

surgery-incision-laser-start = You start the bloodless incision on {THE($target)} with {$tool}.
surgery-incision-laser-end = You make a bloodless incision.

surgery-incision-managed-start = You start to construct a prepared incision on {THE($target)} with {$tool}.
surgery-incision-managed-end = You construct a managed incision with clamping and retraction.

# Clamp
surgery-clamp-start = You start clamping bleeders in {THE($target)} with {$tool}.
surgery-clamp-end = You clamp the bleeders.
surgery-clamp-fail = Your hand slips, tearing blood vessels in {THE($limb)}!

# Retract
surgery-retract-start = You start to pry open the incision on {THE($target)} with {$tool}.
surgery-retract-end = You retract the skin.
surgery-retract-fail = Your hand slips, tearing the edges of the incision on {THE($limb)}!

# Cauterize
surgery-cauterize-start = You begin to cauterize the incision on {THE($target)} with {$tool}.
surgery-cauterize-end = You cauterize the incision.
surgery-cauterize-fail = Your hand slips, burning {THE($limb)}!

# Saw bone (encased)
surgery-saw-start = You begin to cut through {THE($target)} with {$tool}.
surgery-saw-end = You cut through the {$bone} open.
surgery-saw-fail = Your hand slips, cracking the bone in {THE($limb)}!

# Bone repair
surgery-boneglue-start = You start applying bone adhesive on {THE($target)} with {$tool}.
surgery-boneglue-end = You apply bone adhesive to the fracture.
surgery-boneglue-fail = Your hand slips, smearing adhesive in the incision!

surgery-boneset-start = You start to set the bone in {THE($target)} with {$tool}.
surgery-boneset-end = You set the bone in place.
surgery-boneset-fail = Your hand slips, damaging the bone!

surgery-bonefinish-end = You finish the bone repair.
surgery-bone-not-broken = The bone is not broken.

# Amputation
surgery-amputate-start = You begin to amputate {THE($target)} with {$tool}.
surgery-amputate-end = You amputate the limb.
surgery-amputate-fail = Your hand slips, sawing through the bone incorrectly!

# Organ surgery
surgery-organ-detach-start = You start to detach the organ in {THE($target)} with {$tool}.
surgery-organ-detached = You carefully detach the {$organ} from its connections.

surgery-organ-remove-start = You start to remove the organ from {THE($target)} with {$tool}.
surgery-organ-removed = You remove the {$organ} from the body cavity.

surgery-organ-replace-start = You start to insert the organ into {THE($target)} with {$tool}.
surgery-organ-replaced = You place the {$organ} into the body cavity.

surgery-organ-attach-start = You start to attach the organ in {THE($target)} with {$tool}.
surgery-organ-attached = You connect the blood vessels and secure the organ in place.

surgery-organ-fix-start = You begin repairing the internal organ in {THE($target)} with {$tool}.
surgery-organ-repaired = You repair the damaged organ.

surgery-organ-fail = Your hand slips inside {THE($limb)}, damaging internal tissue!

# Embedded objects
surgery-embedded-start = You begin removing an embedded object from {THE($target)} with {$tool}.
surgery-embedded-removed = You remove the embedded object from the wound.
surgery-embedded-fail = Your hand slips, pushing the object deeper into {THE($limb)}!
surgery-no-embedded = There are no embedded objects in this wound.

# Amputation effects
amputation-no-legs = You have no legs! You collapse to the ground!
amputation-one-leg = You only have one leg left! You stumble.
amputation-no-grasp = You can no longer grasp with your {$limb}!
